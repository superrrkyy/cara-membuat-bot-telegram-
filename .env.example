# Dapatkan token dari @BotFather. Jangan pernah commit file .env asli.
BOT_TOKEN=isi_token_dari_botfather

# polling (default) atau webhook
BOT_MODE=polling

# Lokasi database lokal. Pada Docker Compose, nilai ini otomatis menjadi /data/bot.db.
BOT_DB_PATH=bot.db

# Diperlukan hanya jika BOT_MODE=webhook.
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8443
WEBHOOK_PATH=telegram
WEBHOOK_URL=https://domain-anda.example/telegram
# Gunakan string acak 1-256 karakter, hanya huruf, angka, '_' dan '-'.
WEBHOOK_SECRET=ganti_dengan_secret_acak
